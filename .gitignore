# Git ignore rules for Kroki Editorial Diagrams
*.pyc
*.pyo
# IDE / local config
.claude/
.directory
.DS_Store
.env
__pycache__/
.pytest_cache/
build/
dist/
node_modules/

# Generated diagram artifacts (rendered by users)
**/.diagram-meta.json
**/interactive.html
**/rendered.pdf
**/rendered.png
**/rendered.svg
**/index.html

# ...but DO ship the committed showcase examples under docs/examples/
!docs/examples/**
