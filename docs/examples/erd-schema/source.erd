[users] {bgcolor: "#f5f5f5"}
  *id {bgcolor: "#ffffff", label: "PK"}
  name {bgcolor: "#ffffff"}
  email {bgcolor: "#ffffff"}
  password_hash {bgcolor: "#ececec"}
  created_at {bgcolor: "#ececec"}
  updated_at {bgcolor: "#ececec"}

[orders] {bgcolor: "#f5f5f5"}
  *id {bgcolor: "#ffffff", label: "PK"}
  user_id {bgcolor: "#ececec", label: "FK"}
  status {bgcolor: "#ffffff"}
  total {bgcolor: "#ffffff"}
  created_at {bgcolor: "#ececec"}

[order_items] {bgcolor: "#f5f5f5"}
  *id {bgcolor: "#ffffff", label: "PK"}
  order_id {bgcolor: "#ececec", label: "FK"}
  product_id {bgcolor: "#ececec", label: "FK"}
  quantity {bgcolor: "#ffffff"}
  price {bgcolor: "#ffffff"}

[products] {bgcolor: "#f5f5f5"}
  *id {bgcolor: "#ffffff", label: "PK"}
  name {bgcolor: "#ffffff"}
  price {bgcolor: "#ffffff"}
  stock {bgcolor: "#ffffff"}

users 1--* orders
orders 1--* order_items
order_items *--1 products
